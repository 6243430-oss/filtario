# Copy this to .env and fill in your values

# Anthropic (already have this from pirate_ai)
ANTHROPIC_API_KEY=sk-ant-...

# LinkedIn Company Page
# Get token: https://www.linkedin.com/developers/apps -> OAuth 2.0 -> w_member_social scope
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=urn:li:organization:XXXXXXXXX

# X / Twitter
# Get at: https://developer.twitter.com/en/portal -> Project -> Keys and Tokens
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Telegram (create bot via @BotFather, then add to channel as admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_EN=@filtario_en
TELEGRAM_CHANNEL_ES=@filtario_es
